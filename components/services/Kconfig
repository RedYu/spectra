menu "Spectra diagnostics"

config SPECTRA_SD_BENCHMARK_ON_STARTUP
    bool "Run SD-card benchmark during startup"
    default n
    help
        Run a destructive sequential write/read test after mounting
        the SD card. Intended only for development diagnostics.

endmenu

menu "Spectra OTA backend"

config SPECTRA_OTA_BACKEND_CHECK_URL
    string "Firmware update check URL"
    default "https://api.spectra.ridel.com.ua/firmware/check"
    help
        HTTPS endpoint queried by the device for firmware availability.
        A successful response without an update manifest means that no
        update is available. The URL can later be changed to the firmware
        manifest endpoint without changing device code.

config SPECTRA_OTA_BACKEND_CHECK_INTERVAL_MINUTES
    int "Firmware update check interval in minutes"
    range 5 10080
    default 360
    help
        Interval between automatic backend firmware checks while the
        Station interface has Internet access.

endmenu

menu "Spectra web content"

config SPECTRA_WEB_CONTENT_GZIP
    bool "Serve precompressed web resources"
    default n
    help
        Minify text resources and gzip every file from web_src during
        the project build. The generated spiffs_data/www directory
        contains only gzip files. The browser receives the
        Content-Encoding: gzip header.

config SPECTRA_WEB_CONTENT_CACHE
    bool "Enable browser caching for static web resources"
    default n
    help
        Allow browsers to cache HTML, CSS, JavaScript and favicon
        resources. When disabled, the server sends Cache-Control:
        no-store.

config SPECTRA_WEB_CONTENT_CACHE_MAX_AGE
    int "Static resource cache lifetime in seconds"
    depends on SPECTRA_WEB_CONTENT_CACHE
    range 0 31536000
    default 3600
    help
        Number of seconds for which a browser may reuse a static web
        resource without requesting it again.

endmenu
